# Copy this file as .env and fill in the values.
# The real .env is never committed: it holds the secret key and the API key.
# No "$" in values: compose reads this file too. Generate the key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=generate-it-with-secrets-token_urlsafe
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# 127.0.0.1 and not localhost: the container only listens on IPv4, and on
# Windows a connection over ::1 hangs instead of failing.
# Port 5433: see compose.yaml.
DATABASE_URL=postgres://sicom:dev@127.0.0.1:5433/sicom
# Optional. Seconds a database connection is reused (600 if missing).
# CONN_MAX_AGE=600

# Sheet reader. Only needed to read sheets.
OPENROUTER_API_KEY=
# READER_MODEL=minimax/minimax-m3
# READER_MAX_TOKENS=8000
